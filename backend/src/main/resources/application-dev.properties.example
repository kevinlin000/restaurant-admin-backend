# ========================
# 開發環境設定
# ========================
# ⚠️ 此檔案在 .gitignore 中，不會被 commit
# ⚠️ 請複製此檔案為 application-dev.properties 並修改密碼

# 資料庫連線
spring.datasource.url=jdbc:mysql://localhost:3306/restaurant_db?useSSL=false&serverTimezone=Asia/Taipei&characterEncoding=utf-8&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=你的密碼
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 連線池設定
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=30000

# 開發環境顯示 SQL
spring.jpa.show-sql=true
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# JWT 密鑰（開發用，正式環境要換）
jwt.secret=dev-secret-key-please-change-in-production
jwt.expiration=86400000

# Email 驗證信發送端
# 使用 Gmail App Password，不是 Gmail 登入密碼
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=你的Gmail信箱
spring.mail.password=你的Gmail應用程式密碼
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# LINE Pay Sandbox
# 若只測一般訂單可保留預設；要測 LINE Pay 請填 LINE Pay sandbox 後台提供的 channel id / secret。
linepay.channel-id=demo-channel-id
linepay.channel-secret=demo-channel-secret
linepay.api-base-url=https://sandbox-api-pay.line.me
linepay.confirm-url=http://localhost:5173/payment/linepay/confirm
linepay.cancel-url=http://localhost:5173/order

# 前台網址：訂位成功信會使用這個網址產生「訂位成功頁」連結
app.frontend-base-url=http://localhost:5173

# Server
server.port=8080
