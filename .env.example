# ========================
# 資料庫設定
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_db
DB_USERNAME=root
DB_PASSWORD=你的密碼

# ========================
# Spring Boot
# ========================
SERVER_PORT=8080

# ========================
# JWT (會員模組用)
# ========================
JWT_SECRET=請替換成你自己的密鑰
JWT_EXPIRATION=86400000

# ========================
# 檔案上傳 (門市照片、菜單圖片)
# ========================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5MB
